.gitignore

# Unreal Engine에서 생성되는 주요 폴더들
# 이 폴더들은 프로젝트의 임시 데이터, 캐시, 빌드 결과물 등을 담고 있으므로 Git에서 무시해야 합니다.
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Plugins 폴더 내의 바이너리 및 임시 파일들도 무시합니다.
Plugins/*/Binaries/
Plugins/*/Intermediate/

# 맵 빌드 데이터 (동적으로 생성되는 에셋)
*_BuiltData.uasset

# 빌드 관련 특정 예외 처리
# PakBlacklist-*.txt 파일은 특정 빌드 설정에서 에셋 패키징을 제어하는 데 사용되므로 포함될 수 있습니다.
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
# 빌드 폴더 내 아이콘 파일은 무시하지 않습니다.
!Build/**/*.ico

# IDE (Visual Studio, Xcode, Rider, VS Code 등) 관련 임시 파일 및 설정
# -----------------------------------------------------------

# Visual Studio 관련
.vs/
*.VC.db
*.VC.opendb
*.suo
*.user
*.log
*.pdb
*.ipch
*.aps
*.ncb
*.opensdf
*.sdf
*.tlog

# 솔루션 파일 (.sln):
# 대부분의 팀에서는 .sln 파일을 Git에 포함하여 모든 팀원이 동일한 프로젝트 구조를 사용하도록 합니다.
# 만약 .sln 파일을 개인 환경에 따라 다르게 관리하고 싶다면 아래 주석을 해제하세요.
# *.sln

# Xcode 관련 (macOS 환경에서 개발 시)
*.xcodeproj/
*.xcworkspace/

# VS Code 관련
.vscode/

# JetBrains Rider 관련
.idea/

# 컴파일된 오브젝트 파일 (Binaries 및 Intermediate에 포함되기도 하지만 명시적으로 추가)
*.slo
*.lo
*.o
*.obj

# 프리컴파일된 헤더
*.gch
*.pch

# 컴파일된 라이브러리 (동적 및 정적) 및 실행 파일
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# 일반적인 임시 및 백업 파일
*~
*.bak
*.tmp

# macOS 관련 시스템 파일 (Mac에서 작업할 경우)
.DS_Store

# 파이썬 캐시 (Python 스크립트 사용 시)
__pycache__/

# SourceArt 폴더 내의 특정 형식 파일은 보통 버전 관리에 포함됩니다.
# 만약 SourceArt 내에 Git에 포함하지 않을 특정 파생 파일이 있다면 여기에 추가하세요.
# 예시: SourceArt/**/*.generated.png

# Ignore StarterPack folder in Content directory
Content/StarterContent/